# =============================================================================
# ROADSense AI — Production Environment Configuration
# =============================================================================

# Server Environment (development | production)
ENVIRONMENT=development
PORT=8000

# Database Configuration
# - For Local SQLite: sqlite:///./roadsense.db
# - For Railway / Supabase / Neon PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./roadsense.db

# JWT & Security Configuration
# Generate a strong key: openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq LPU AI Copilot Configuration (Optional: provides sub-second LLM answers)
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Allowed Origins (Comma-separated or * for wildcard)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://roadsense-ai.vercel.app,*

# Frontend API URL (for Vite build)
VITE_API_URL=/api/v1

